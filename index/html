<!DOCTYPE html>
<html>
<head>
    <title>Тест слов EN-RU</title>
    <meta charset="UTF-8">
    <style>
        body { font-family: Arial; padding: 20px; }
        .question { font-size: 24px; margin: 20px 0; padding: 15px; background: #e3f2fd; }
        .answer { margin: 10px; padding: 15px; border: 2px solid #ccc; cursor: pointer; }
        .answer:hover { background: #f5f5f5; }
        .correct { background: #d4edda; border-color: #28a745; }
        .wrong { background: #f8d7da; border-color: #dc3545; }
        button { margin: 10px; padding: 12px 24px; font-size: 18px; }
    </style>
</head>
<body>
    <h1>Тест английских слов</h1>
    <p>Вопрос <span id="num">1</span> из <span id="total">14</span></p>
    <div class="question" id="question">Вопрос</div>
    <div id="answers"></div>
    <button onclick="check()">Проверить</button>
    <button onclick="next()" id="nextBtn" disabled>Дальше</button>
    <button onclick="shuffle()">Перемешать</button>
    <button onclick="switchMode()">EN↔RU</button>
    <p>Правильно: <span id="score">0</span></p>
    <p id="result"></p>

    <script>
        const words = [
            {en:"to lay upon a sofa", ru:"лежать на диване"},
            {en:"to glimpse", ru:"мельком увидеть"},
            {en:"to labour", ru:"изнурительно уговаривать"},
            {en:"to hail", ru:"окликать"},
            {en:"to row", ru:"грести"},
            {en:"to draw", ru:"утонуть"},
            {en:"to escape", ru:"спасаться бегством"},
            {en:"to put in striking condition", ru:"приукрашивать рассказ разными подробностями"},
            {en:"to push ones head and shoulders through", ru:"просунуть голову и плечи"},
            {en:"to cry of gladness", ru:"плакать от радости"},
            {en:"a speck of daylight", ru:"проблеск дневного света"},
            {en:"twine clew", ru:"моток бочевки"},
            {en:"bassage", ru:"коридор проход"}
        ];

        let mode = 'en-ru';
        let current = 0;
        let score = 0;
        let selected = null;
        let shuffled = [...words];
        
        function show() {
            document.getElementById('num').textContent = current + 1;
            document.getElementById('total').textContent = shuffled.length;
            const q = shuffled[current];
            document.getElementById('question').textContent = mode === 'en-ru' ? q.en : q.ru;
            
            let answers = [mode === 'en-ru' ? q.ru : q.en];
            let others = shuffled.filter((w,i) => i !== current)
                                 .slice(0,3)
                                 .map(w => mode === 'en-ru' ? w.ru : w.en);
            answers = answers.concat(others).sort(() => Math.random() - 0.5);
            
            const container = document.getElementById('answers');
            container.innerHTML = '';
            answers.forEach(a => {
                const div = document.createElement('div');
                div.className = 'answer';
                div.textContent = a;
                div.onclick = () => {
                    document.querySelectorAll('.answer').forEach(el => el.style.background = '');
                    div.style.background = '#e3f2fd';
                    selected = a;
                };
                container.appendChild(div);
            });
            document.getElementById('result').textContent = '';
            document.getElementById('nextBtn').disabled = true;
            selected = null;
        }

        function check() {
            if (!selected) return;
            const correct = mode === 'en-ru' ? shuffled[current].ru : shuffled[current].en;
            const isCorrect = selected === correct;
            
            document.querySelectorAll('.answer').forEach(el => {
                el.classList.remove('correct', 'wrong');
                if (el.textContent === correct) el.classList.add('correct');
                if (el.textContent === selected && !isCorrect) el.classList.add('wrong');
            });
            
            if (isCorrect) {
                score++;
                document.getElementById('score').textContent = score;
                document.getElementById('result').textContent = '✅ Верно!';
            } else {
                document.getElementById('result').textContent = `❌ Неверно! Правильно: ${correct}`;
            }
            document.getElementById('nextBtn').disabled = false;
        }

        function next() {
            current = (current + 1) % shuffled.length;
            show();
        }

        function shuffle() {
            shuffled = [...words].sort(() => Math.random() - 0.5);
            current = 0;
            score = 0;
            document.getElementById('score').textContent = score;
            show();
            alert('Вопросы перемешаны!');
        }

        function switchMode() {
            mode = mode === 'en-ru' ? 'ru-en' : 'en-ru';
            current = 0;
            show();
            alert(`Режим: ${mode === 'en-ru' ? 'EN → RU' : 'RU → EN'}`);
        }

        show();
    </script>
</body>
</html>
